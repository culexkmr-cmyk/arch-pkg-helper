# Maintainer: culexkmr-cmyk <279788126+culexkmr-cmyk@users.noreply.github.com>
pkgname=apkg-bin
pkgver=1.2.0
pkgrel=1
pkgdesc="Arch Linux package helper CLI (apkg): pacman, AUR, git, scripts and PKGBUILDs"
arch=('x86_64')
url="https://github.com/culexkmr-cmyk/arch-pkg-helper"
license=('AGPL-3.0-only')
depends=('pacman' 'sudo' 'git' 'curl')
optdepends=('paru: AUR support'
            'yay: AUR support'
            'pacman-contrib: updates and cache cleanup')
provides=('apkg')
conflicts=('apkg' 'apkg-git')
source=("apkg-$pkgver::https://github.com/culexkmr-cmyk/arch-pkg-helper/releases/download/v$pkgver/pkg-x86_64-linux"
        "apkg-$pkgver-src.tar.gz::https://github.com/culexkmr-cmyk/arch-pkg-helper/archive/v$pkgver.tar.gz")
sha256sums=('6c4c924149547287c8ab121e73e5461c80ec4bfa28e69fe654ab9e28827c3f3f'
            '75de63a4df4c950cc3bf46348295ff2f8e9a931b865481c610d75644489619c7')

package() {
  install -Dm755 "$srcdir/apkg-$pkgver" "$pkgdir/usr/bin/apkg"
  install -Dm644 "$srcdir/arch-pkg-helper-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/arch-pkg-helper-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
